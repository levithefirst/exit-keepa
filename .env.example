# ------------------------------------------------------------------
# Exit Keepa - environment variables
#
# Copy this file to .env (root, for local docker/dev convenience) and/or
# apps/api/.env and apps/web/.env.local as appropriate.
#
# NEVER commit real values. All secrets are provided at deploy time via
# Railway (backend) and Vercel (frontend) project environment settings.
# ------------------------------------------------------------------

# ---------- apps/api (Railway) ----------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Neon Postgres connection string (pooled connection recommended)
# https://neon.tech -> Project -> Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of origins allowed to call the API (frontend URL(s)).
# Use "*" to allow any browser origin - safe here since this API has no
# cookie/session auth to protect. Unset/empty disables CORS entirely
# (no cross-origin browser request will succeed), which is fine for
# local dev (same-origin via Next.js rewrites) but breaks a real deployed
# frontend on a different domain.
CORS_ORIGINS=http://localhost:3000

# KeeperHub (https://docs.keeperhub.com) - execution/reliability layer
# API key created in KeeperHub dashboard: Settings > API Keys (kh_ prefix)
KEEPERHUB_API_KEY=kh_xxxxxxxxxxxxxxxxxxxxxxxx
# Base URL for KeeperHub's REST API
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com/api
# Shared secret used to verify signatures on inbound KeeperHub webhooks
# (execution status callbacks). Configure the same value in the KeeperHub
# dashboard when registering the webhook.
KEEPERHUB_WEBHOOK_SECRET=replace-with-a-long-random-value

# Base network (https://base.org) - chain the Safe + exit strategies live on.
#
# BASE_RPC_URL MUST be a key-authenticated endpoint (Alchemy, Infura,
# QuickNode, ...) in any deployed environment. Verifying one Safe reads the
# module list, each module's bytecode and Roles invariants, the exact role
# storage slots and five negative permission probes; the free public
# endpoint below rate-limits (HTTP 429) well before that finishes, and a
# read that cannot complete fails closed - which shows the owner of a
# perfectly good Safe an "unverifiable" card. The public URL is fine for
# local development only. Never commit a real key: set it in the host's
# environment (Railway variables) instead.
BASE_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
# Tried in turn when the primary refuses (quota, 429, transport failure).
# Independent operators on purpose, so one provider's limit is not the
# next one's. Leave unset to use these defaults.
BASE_RPC_FALLBACKS=https://base.publicnode.com,https://1rpc.io/base,https://base.drpc.org

# Broadcast gate. Defaults to unset, and no broadcast code path in this
# repository runs unless this is exactly the string "1" - not "true", not
# "yes", not "1 ". Leave it unset unless you specifically intend to enable
# a gated broadcast path.
#
# The MCP server (packages/mcp) is stronger than gated: it has no
# broadcast implementation at all, so setting this does not give it one.
# EXIT_KEEPA_ALLOW_BROADCAST=

# ---------- packages/mcp (MCP server) ----------

# The MCP server reuses KEEPERHUB_API_KEY / KEEPERHUB_API_BASE_URL /
# BASE_RPC_URL from above. It needs no DATABASE_URL and no webhook secret
# - it opens no database and serves no webhook. See packages/mcp/README.md.

# ---------- apps/web (Vercel) ----------

# Public URL of the deployed apps/api service
NEXT_PUBLIC_API_URL=http://localhost:4000
